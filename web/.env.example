# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Server-side only: never prefix with NEXT_PUBLIC_.

# OpenRouter key for /api/chat: https://openrouter.ai/keys (set a credit limit on it)
OPENROUTER_API_KEY=
# Any OpenRouter model id; blank uses anthropic/claude-opus-5.5
OPENROUTER_MODEL=
# Vision model for identify-items (photo -> proposed inventory); blank uses anthropic/claude-sonnet-5.5
OPENROUTER_VISION_MODEL=
# Required spend cap in USD for vision calls, per server instance; the key's credit limit is the durable backstop
OPENROUTER_SPEND_CAP_USD=

# Agent container (apps/agent-worker). Blank = the cleanup page shows demo data.
AGENT_WORKER_URL=
AGENT_WORKER_SECRET=
