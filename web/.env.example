# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# --- Server-side only: never prefix these with NEXT_PUBLIC_ ---

# OpenRouter key for /api/chat: https://openrouter.ai/keys (set a credit limit on it)
OPENROUTER_API_KEY=
# Any OpenRouter model id; blank uses anthropic/claude-opus-5.5
OPENROUTER_MODEL=

# --- Public by design (shipped to the browser) ---

# Supabase project (Settings → API). Use the publishable key, never the secret key.
# Without these the site runs as a demo with no login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
