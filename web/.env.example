# Vacate web app: every environment variable the code reads.
# Copy to web/.env.local (git-ignored) and fill in. On Vercel, set them under
# Project → Settings → Environment Variables. Never commit real values.

# ---------------------------------------------------------------------
# Supabase (required for login and all app data)
# Hosted: Supabase dashboard → Project Settings → API Keys.
# Local:  `supabase start`, then `supabase status` prints these.
# Without the URL and publishable key the site runs as a demo with no login.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…): safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only if no publishable key exists. Prefer the key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…): server only, bypasses RLS. Used for owner-scoped
# database functions (Muse bridge, connector tokens). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Identifiers for CLI linking (not secret; not read by the app).
SUPABASE_ORG_ID=
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------
# Vercel identifiers (not secret). The Vercel CLI reads these two instead of
# a .vercel/ link folder; deploy with your own `vercel login`, not a shared token.
# ---------------------------------------------------------------------
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------
# App URL
# Public origin that the Agent Card, MCP and OAuth metadata advertise.
# Local dev: http://localhost:3100. On Vercel leave unset: the production
# domain or branch alias is used (VERCEL_* variables are set by Vercel).
# ---------------------------------------------------------------------
APP_URL=

# ---------------------------------------------------------------------
# OpenRouter (/api/chat). https://openrouter.ai/keys, set a credit limit.
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=
# Any OpenRouter model id; blank uses anthropic/claude-opus-5.5
OPENROUTER_MODEL=
# Vision model for identify-items (photo -> proposed inventory); blank uses anthropic/claude-sonnet-5.5
OPENROUTER_VISION_MODEL=
# Required spend cap in USD for chat and vision calls, per server instance; the key's credit limit is the durable backstop
OPENROUTER_SPEND_CAP_USD=
# Blank uses https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# ---------------------------------------------------------------------
# Google OAuth client for the Gmail/Calendar adapters (server only).
# Google *sign-in* is configured in Supabase Auth → Providers, not here.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Muse developer tools (personal; local only, not needed on Vercel).
# See docs/MUSE_SETUP.md. Posting to Facebook does not need these.
# ---------------------------------------------------------------------
# Muse Code host / SDK sessions (npm run muse:check). Keys start with LLM_.
META_API_KEY=
# Direct Meta Model API calls (https://api.meta.ai/v1)
MODEL_API_KEY=
# Path to the muse binary if it is not on PATH
MUSE_BIN=

# ---------------------------------------------------------------------
# Connector test scripts (scripts/a2a-client-check.mjs)
# ---------------------------------------------------------------------
# App to test, e.g. http://localhost:3100
VACATE_URL=
# vac_… token created on /muse (shown once)
VACATE_CONNECTOR_TOKEN=

# ---------------------------------------------------------------------
# Telegram selling (/sell). Server only. See web/README.md "Sell on Telegram".
# ---------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# The bot's username, e.g. VacateSaleBot (used for "Message seller" links)
TELEGRAM_BOT_USERNAME=
# Public sale channel, e.g. @vacate_sale (the bot must be an admin that can post)
TELEGRAM_CHANNEL_ID=
# Random string passed to setWebhook as secret_token; Telegram echoes it on every update
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/price-drops
CRON_SECRET=

# Optional reviewed Bland calls (never enable by putting a real call in a test).
BLAND_API_KEY=
BLAND_VOICE=
# Comma-separated permitted destination numbers for the call adapter.
CALL_ALLOWLIST=
# Explicit opt-in for hosted mutation test scripts; leave unset for normal use.
HOSTED_CHECK_CONFIRM=

# Optional fixture-only catalogs for local demos; blank reads Supabase.
CLEANING_CATALOG_SOURCE=
MOVING_CATALOG_SOURCE=
