# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Supabase project (Settings → API). Without these the site runs as a demo with no login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for owner-scoped database functions (Muse bridge). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Public origin of this deployment; the Agent Card, MCP and OAuth metadata advertise it.
APP_URL=

# OpenRouter key for /api/chat: https://openrouter.ai/keys (set a credit limit on it)
OPENROUTER_API_KEY=
# Any OpenRouter model id; blank uses anthropic/claude-opus-5.5
OPENROUTER_MODEL=
